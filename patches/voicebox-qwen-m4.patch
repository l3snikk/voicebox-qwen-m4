+def trim_leading_artifact(
+    audio: np.ndarray,
+    sample_rate: int = 24000,
+    frame_ms: int = 10,
+    burst_threshold_db: float = -38.0,
+    dip_threshold_db: float = -58.0,
+    min_dip_ms: int = 30,
+    max_burst_ms: int = 800,
+    lookahead_ms: int = 1200,
+    speech_after_db: float = -45.0,
+    decay_diff_db: float = 6.0,
+    margin_ms: int = 20,
+    fade_ms: int = 10,
+) -> np.ndarray:
+    """Remove a Qwen leading burst only when burst/decay/dip/speech all match."""
+    frame_len = int(sample_rate * frame_ms / 1000)
+    if frame_len == 0 or len(audio) < frame_len * 4:
+        return audio
+
+    n_frames = len(audio) // frame_len
+    rms = np.array(
+        [
+            np.sqrt(np.mean(audio[i * frame_len : (i + 1) * frame_len] ** 2))
+            for i in range(n_frames)
+        ]
+    )
+    db = 20.0 * np.log10(rms + 1e-12)
+    min_dip_frames = max(1, int(min_dip_ms / frame_ms))
+    max_burst_frames = int(max_burst_ms / frame_ms)
+    lookahead_frames = int(lookahead_ms / frame_ms)
+
+    loud_idx = np.where(db > burst_threshold_db)[0]
+    if len(loud_idx) == 0:
+        return audio
+    burst_start = int(loud_idx[0])
+
+    dip_start = -1
+    dip_len = 0
+    index = burst_start + 1
+    limit = min(n_frames, burst_start + max_burst_frames + min_dip_frames)
+    while index < limit:
+        if db[index] < dip_threshold_db:
+            dip_end = index
+            while dip_end < limit and db[dip_end] < dip_threshold_db:
+                dip_end += 1
+            if dip_end - index >= min_dip_frames:
+                dip_start = index
+                dip_len = dip_end - index
+                break
+            index = dip_end
+        else:
+            index += 1
+
+    if dip_start == -1:
+        return audio
+
+    burst = db[burst_start:dip_start]
+    if len(burst) >= 4:
+        half = len(burst) // 2
+        if float(np.mean(burst[:half]) - np.mean(burst[half : half * 2])) < decay_diff_db:
+            return audio
+
+    after_start = dip_start + dip_len
+    window_end = min(n_frames, after_start + lookahead_frames)
+    if window_end <= after_start or float(np.max(db[after_start:window_end])) < speech_after_db:
+        return audio
+
+    trim_frame = after_start + int(margin_ms / frame_ms)
+    start_sample = min(trim_frame * frame_len, len(audio) - 1)
+    trimmed = audio[start_sample:].copy()
+    fade_samples = int(sample_rate * fade_ms / 1000)
+    if fade_samples > 0 and len(trimmed) > fade_samples:
+        fade = np.sin(np.linspace(0, np.pi / 2, fade_samples)) ** 2
+        trimmed[:fade_samples] *= fade
+    return trimmed
+
+
+def build_trim_fn(engine: str):
+    """Return the conservative per-chunk trim pipeline for an engine."""
+    from ..backends import engine_needs_trim
+
+    needs_leading_trim = engine in {"qwen", "qwen_custom_voice"}
+    needs_trailing_trim = engine_needs_trim(engine)
+    if not needs_leading_trim and not needs_trailing_trim:
+        return None
+
+    def _trim(audio: np.ndarray, sample_rate: int) -> np.ndarray:
+        if needs_leading_trim:
+            audio = trim_leading_artifact(audio, sample_rate)
+        if needs_trailing_trim:
+            audio = trim_tts_output(audio, sample_rate)
+        return audio
+
+    return _trim
+
+
