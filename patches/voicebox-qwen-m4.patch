diff --git a/scripts/build-macos-arm64.sh b/scripts/build-macos-arm64.sh
new file mode 100755
index 0000000..cd47bd0
--- /dev/null
+++ b/scripts/build-macos-arm64.sh
@@ -0,0 +1,79 @@
+#!/usr/bin/env bash
+
+set -euo pipefail
+
+project_dir="$(cd "$(dirname "$0")/.." && pwd)"
+cd "$project_dir"
+log_path="$project_dir/build-macos-arm64.log"
+exec > >(tee "$log_path") 2>&1
+trap 'status=$?; if [[ $status -ne 0 ]]; then echo "Build failed (exit $status). Log: $log_path"; fi' EXIT
+
+if [[ "$(uname -s)" != "Darwin" || "$(uname -m)" != "arm64" ]]; then
+  echo "Error: this build must run on an Apple Silicon Mac (arm64)." >&2
+  exit 1
+fi
+
+for command_name in brew xcode-select; do
+  if ! command -v "$command_name" >/dev/null 2>&1; then
+    echo "Error: missing $command_name." >&2
+    exit 1
+  fi
+done
+
+if ! xcode-select -p >/dev/null 2>&1; then
+  echo "Error: install Xcode Command Line Tools with: xcode-select --install" >&2
+  exit 1
+fi
+
+brew install python@3.12 llvm@20 bun
+
+if ! command -v rustup >/dev/null 2>&1; then
+  brew install rustup-init
+  rustup-init -y --profile minimal
+fi
+export PATH="$HOME/.cargo/bin:$(brew --prefix python@3.12)/bin:$(brew --prefix llvm@20)/bin:$PATH"
+export LLVM_CONFIG="$(brew --prefix llvm@20)/bin/llvm-config"
+
+rustup toolchain install stable --profile minimal
+rustup target add aarch64-apple-darwin
+
+python3.12 -m venv backend/venv
+backend/venv/bin/python -m pip install --upgrade pip wheel setuptools
+backend/venv/bin/pip install pyinstaller
+backend/venv/bin/pip install -r backend/requirements.txt
+backend/venv/bin/pip install --no-deps chatterbox-tts hume-tada
+backend/venv/bin/pip install -r backend/requirements-mlx.txt
+backend/venv/bin/pip install --no-deps mlx-lm==0.31.1 mlx-audio==0.4.1
+
+bun install --frozen-lockfile
+backend/venv/bin/python -m pytest \
+  backend/tests/test_qwen_generation_guards.py \
+  backend/tests/test_qwen_runaway_retry.py \
+  backend/tests/test_mlx_unload_clears_cache.py \
+  backend/tests/test_voice_prompt_cache_unload.py \
+  backend/tests/test_qwen_artifact_and_paragraphs.py
+bun run typecheck
+
+./scripts/build-server.sh
+(
+  cd tauri
+  bun run tauri build \
+    --target aarch64-apple-darwin \
+    --config src-tauri/tauri.qwen-mac.conf.json \
+    --bundles app,dmg
+)
+
+app_path="tauri/src-tauri/target/aarch64-apple-darwin/release/bundle/macos/Voicebox Qwen M4.app"
+if [[ ! -d "$app_path" ]]; then
+  echo "Error: app bundle was not produced at: $app_path" >&2
+  exit 1
+fi
+
+codesign --force --deep --sign - "$app_path"
+codesign --verify --deep --strict --verbose=2 "$app_path"
+
+echo ""
+echo "Build complete:"
+echo "  $app_path"
+echo "  tauri/src-tauri/target/aarch64-apple-darwin/release/bundle/dmg/"
+echo "  Log: $log_path"
