@@ -0,0 +1,70 @@
+name: Build Voicebox Qwen for Apple Silicon
+
+on:
+  workflow_dispatch:
+
+jobs:
+  build:
+    runs-on: macos-15
+    timeout-minutes: 120
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Install build tools
+        run: brew install python@3.12 llvm@20 bun
+
+      - name: Configure toolchains
+        run: |
+          echo "$(brew --prefix python@3.12)/bin" >> "$GITHUB_PATH"
+          echo "$(brew --prefix llvm@20)/bin" >> "$GITHUB_PATH"
+          echo "LLVM_CONFIG=$(brew --prefix llvm@20)/bin/llvm-config" >> "$GITHUB_ENV"
+          rustup target add aarch64-apple-darwin
+
+      - name: Install Python dependencies
+        run: |
+          python3.12 -m venv backend/venv
+          backend/venv/bin/python -m pip install --upgrade pip wheel setuptools pyinstaller
+          backend/venv/bin/pip install -r backend/requirements.txt
+          backend/venv/bin/pip install --no-deps chatterbox-tts hume-tada
+          backend/venv/bin/pip install -r backend/requirements-mlx.txt
+          backend/venv/bin/pip install --no-deps mlx-lm==0.31.1 mlx-audio==0.4.1
+
+      - name: Install frontend dependencies
+        run: bun install --frozen-lockfile
+
+      - name: Test Qwen and MLX patches
+        run: |
+          backend/venv/bin/python -m pytest \
+            backend/tests/test_qwen_generation_guards.py \
+            backend/tests/test_qwen_runaway_retry.py \
+            backend/tests/test_mlx_unload_clears_cache.py \
+            backend/tests/test_voice_prompt_cache_unload.py \
+            backend/tests/test_qwen_artifact_and_paragraphs.py
+          bun run typecheck
+
+      - name: Build sidecars
+        run: ./scripts/build-server.sh
+
+      - name: Build app
+        run: |
+          cd tauri
+          bun run tauri build \
+            --target aarch64-apple-darwin \
+            --config src-tauri/tauri.qwen-mac.conf.json \
+            --bundles app,dmg
+
+      - name: Ad-hoc sign and verify app
+        run: |
+          app_path="tauri/src-tauri/target/aarch64-apple-darwin/release/bundle/macos/Voicebox Qwen M4.app"
+          codesign --force --deep --sign - "$app_path"
+          codesign --verify --deep --strict --verbose=2 "$app_path"
+
+      - name: Upload app and DMG
+        uses: actions/upload-artifact@v4
+        with:
+          name: Voicebox-Qwen-M4
+          if-no-files-found: error
+          path: |
+            tauri/src-tauri/target/aarch64-apple-darwin/release/bundle/macos/Voicebox Qwen M4.app
+            tauri/src-tauri/target/aarch64-apple-darwin/release/bundle/dmg/*.dmg
